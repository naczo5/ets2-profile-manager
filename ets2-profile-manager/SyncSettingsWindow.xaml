<Window
    x:Class="Ets2ProfileManager.SyncSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sync settings between profiles">
    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Source profile (settings are copied FROM here):" FontWeight="SemiBold"/>
            <ComboBox x:Name="cmbSource" DisplayMemberPath="Username"
                      SelectionChanged="Source_Changed" HorizontalAlignment="Stretch"/>
            <TextBlock x:Name="lblSourceInfo" Opacity="0.7"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="Target profiles (same game only):" FontWeight="SemiBold"/>
            <ScrollViewer MaxHeight="110">
                <StackPanel x:Name="pnlTargets"/>
            </ScrollViewer>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock Text="Setting groups to sync:" FontWeight="SemiBold"/>
            <ScrollViewer MaxHeight="150">
                <StackPanel x:Name="pnlGroups"/>
            </ScrollViewer>
            <TextBlock Text="Each target is auto-backed up to ets2-profile-manager-backups before writing. Writes are atomic and re-validated."
                       Opacity="0.7" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock Text="Preview (differences that would be applied):" FontWeight="SemiBold"/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="txtPreview" FontFamily="Consolas" TextWrapping="Wrap"/>
            </ScrollViewer>
        </StackPanel>

        <StackPanel Grid.Row="4" Spacing="8">
            <TextBlock x:Name="lblStatus" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Preview" Click="Preview_Click"/>
                <Button Content="Apply sync" Click="Apply_Click" Style="{StaticResource AccentButtonStyle}"/>
                <Button Content="Close" Click="Close_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
